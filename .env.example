# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# ADMIN_PASSWORD: password for the /admin panel. Required — if unset, admin
# auth fails closed (no default). Use a long random value in production.
ADMIN_PASSWORD="change-me"

# PROMETHEUS_URL: base URL of the Prometheus server the /api/gpus endpoint
# queries server-side (e.g. http://prometheus.internal:9090). Required for
# GPU monitoring; if unset, /api/gpus returns 503. Never exposed to clients.
PROMETHEUS_URL="http://prometheus.example:9090"

# GEMINI_API_KEY: required for Gemini AI API calls (injected at runtime by
# the host; configure via your host's secrets panel).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the URL where this app is hosted (self-referential links, etc.).
APP_URL="MY_APP_URL"
